modules = ["web", "bash", "nodejs-24"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kitchen Sink"

[[workflows.workflow]]
name = "Web App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "yarn dev:web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Kitchen Sink"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "yarn workspace @adahiya/kitchen-sink run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "static"
build = ["yarn", "build:web"]
publicDir = "packages/raga-web-app/dist"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
