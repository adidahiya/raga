{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@adahiya/raga-design-system",
  "sourceRoot": "packages/raga-design-system/src",
  "projectType": "library",
  "targets": {
    "check-types": {
      "executor": "nx:run-script",
      "options": { "script": "check-types" }
    },
    "check-lint": {
      "executor": "nx:run-script",
      "options": { "script": "check-lint" }
    },
    "lint-fix": {
      "executor": "nx:run-script",
      "options": { "script": "lint-fix" }
    },
    "clean": {
      "executor": "nx:run-script",
      "options": { "script": "clean" }
    },
    "gen:tokens": {
      "executor": "nx:run-script",
      "options": { "script": "gen:tokens" }
    },
    "check:tokens": {
      "executor": "nx:run-script",
      "options": { "script": "check:tokens" }
    }
  }
}
