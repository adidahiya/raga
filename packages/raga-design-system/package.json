{
  "name": "@adahiya/raga-design-system",
  "version": "0.0.1",
  "private": true,
  "description": "Raga design system: tokens, primitives, and the kitchen-sink spec sheet.",
  "type": "module",
  "main": "./src/primitives/index.ts",
  "exports": {
    ".": "./src/primitives/index.ts",
    "./tokens": "./src/tokens/tokens.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/global.css": "./src/styles/global.css"
  },
  "scripts": {
    "gen:tokens": "tsx scripts/generate-tokens-css.ts",
    "check:tokens": "tsx scripts/generate-tokens-css.ts --check",
    "predev": "tsx scripts/generate-tokens-css.ts",
    "prebuild": "tsx scripts/generate-tokens-css.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check-lint": "tsx scripts/generate-tokens-css.ts --check && eslint .",
    "check-types": "tsc --noEmit",
    "lint-fix": "eslint --fix .",
    "clean": "rm -rf dist .vite"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
